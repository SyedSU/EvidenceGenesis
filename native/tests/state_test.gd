extends SceneTree

func _initialize():
	var state=GenesisState.new()
	assert(state.valid(state.data))
	assert(state.teach("preference","format","numbered steps"))
	assert(state.teach("preference","FORMAT","bullets"))
	assert(state.actor().lessons.size()==1)
	assert(state.template("Example","One\nTwo").contains("- One"))
	assert(not state.teach("instruction","","bad"))
	var doc=state.deliver("Check","# Hello\n<script>alert(1)</script>","Template",0)
	state.approve(doc);state.approve(doc)
	assert(state.data.stars==1 and state.actor().approved==1)
	doc.accepted=false;state.approve(doc);assert(state.data.stars==1)
	var html=GenesisDocuments.html(doc)
	assert(not html.contains("<script>"))
	assert(html.contains("&lt;script&gt;"))
	assert(state.save())
	var restored=GenesisState.new();restored.load_save()
	assert(restored.valid(restored.data))
	assert(restored.data.documents[0].content==doc.content)
	assert(restored.data.crew[0].lessons[0].value=="bullets")
	var invalid=state.data.duplicate(true);invalid.version=true
	assert(not state.valid(invalid))
	invalid=state.data.duplicate(true);invalid.crew[0].energy=-1
	assert(not state.valid(invalid))
	invalid=state.data.duplicate(true);invalid.documents[0].actor=7
	assert(not state.valid(invalid))
	invalid=state.data.duplicate(true);invalid.crew[1].lessons=[{"bad":"data"}]
	assert(not state.valid(invalid))
	# Old native saves migrate without changing lessons, documents or rewards.
	var legacy=state.data.duplicate(true);legacy.version=2;legacy.erase("progress");legacy.erase("decor")
	assert(state.valid(legacy))
	var legacy_file=FileAccess.open(GenesisState.SAVE,FileAccess.WRITE)
	legacy_file.store_string(JSON.stringify(legacy));legacy_file.close()
	var migrated=GenesisState.new();migrated.load_save()
	assert(migrated.data.version==4 and migrated.valid(migrated.data))
	assert(migrated.data.documents[0].content==doc.content)
	assert(migrated.data.crew[0].approved==1)
	assert(migrated.data.progress.claims.is_empty())
	# Mission rewards require real milestones and cannot be farmed.
	var journey=GenesisState.new();journey.save_path="user://mission-test.json"
	journey.claim_mission("approval");assert(journey.data.stars==0)
	journey.teach("vocabulary","hello","a greeting")
	journey.claim_mission("lesson");assert(journey.data.berries==7)
	journey.claim_mission("lesson");assert(journey.data.berries==7)
	journey.feed();journey.rest(0)
	assert(journey.data.progress.fed==1 and journey.data.progress.rested==1)
	journey.claim_mission("care");assert("care" in journey.data.progress.claims)
	for i in 3:
		var made=journey.deliver("Practice","A useful draft","Template",0);journey.approve(made)
	assert(journey.level(0)==2)
	journey.claim_mission("approval");assert(journey.data.stars==4)
	journey.claim_mission("team");assert("team" not in journey.data.progress.claims)
	var partner=journey.deliver("Review","Checked draft","Template",1);journey.approve(partner)
	journey.claim_mission("team");assert(journey.data.stars==7)
	journey.buy_upgrade("garden");assert(journey.data.garden and journey.data.stars==5)
	journey.buy_upgrade("garden");assert(journey.data.stars==5)
	journey.buy_upgrade("lanterns");assert(journey.data.decor.lanterns and journey.data.stars==2)
	journey.buy_upgrade("reading_corner");assert(not journey.data.decor.reading_corner)
	journey.data.stars=4;journey.buy_upgrade("reading_corner")
	assert(journey.data.decor.reading_corner and journey.data.stars==0)
	assert(journey.valid(JSON.parse_string(JSON.stringify(journey.data))))
	invalid=journey.data.duplicate(true);invalid.progress.claims=["care","care"]
	assert(not journey.valid(invalid))
	var file=FileAccess.open(GenesisState.SAVE,FileAccess.WRITE)
	file.store_string("invalid original save");file.close()
	restored.load_save();assert(not restored.save_enabled)
	assert(not restored.save())
	assert(FileAccess.get_file_as_string(GenesisState.SAVE)=="invalid original save")

	var task_state=GenesisState.new();task_state.save_path="user://recovery-test.json"
	var task=task_state.queue_task("Draft","One\nTwo",0,"Template")
	assert(task.status=="queued")
	task_state.task_status(task.id,"running")
	var recovered=GenesisState.new();recovered.adopt(task_state.data)
	assert(recovered.data.tasks[0].status=="failed" and recovered.data.stars==0)
	assert(GenesisDocuments.html({"title":"List","content":"1. One\n2. Two","mode":"Template"}).contains("<ol><li>One</li><li>Two</li></ol>"))
	var profiles=GenesisProfiles.new();profiles.load_index()
	var first=profiles.create("First");assert(first!=null)
	first.teach("preference","format","numbered")
	var second=profiles.create("Second");assert(second.actor().lessons.is_empty())
	var reopened=profiles.open_profile(profiles.entries[0].id);assert(reopened.actor().lessons.size()==1)

	assert(FileAccess.get_file_as_string(GenesisState.SAVE)=="invalid original save")
	var bad_index=FileAccess.open(GenesisProfiles.INDEX,FileAccess.WRITE);bad_index.store_string("broken index");bad_index.close()
	var protected_profiles=GenesisProfiles.new();protected_profiles.load_index()
	assert(not protected_profiles.writable and protected_profiles.create("Do not overwrite")==null)
	assert(FileAccess.get_file_as_string(GenesisProfiles.INDEX)=="broken index")
	var invalid_task=task_state.data.duplicate(true);invalid_task.tasks[0].error=7;assert(not task_state.valid(invalid_task))
	var failure=GenesisState.new();failure.save_path="user://approval-failure.json"
	var unsafe_doc=failure.deliver("Draft","Notes","Template",0);failure.save_enabled=false
	assert(not failure.approve(unsafe_doc) and not unsafe_doc.accepted and not unsafe_doc.credited and failure.data.stars==0 and failure.actor().approved==0)
	failure.actor().lessons.append({"id":"test","kind":"preference","key":"format","value":"steps"})
	failure.claim_mission("lesson");assert(failure.data.berries==5 and failure.data.progress.claims.is_empty())
	failure.data.stars=4;failure.buy_upgrade("garden");assert(not failure.data.garden and failure.data.stars==4)

	var memory=GenesisState.new();memory.save_path="user://memory-failure.json"
	assert(memory.teach("preference","format","numbered"))
	var memory_disk=FileAccess.get_file_as_string(memory.save_path);var lesson_id=memory.actor().lessons[0].id
	memory.save_enabled=false
	assert(not memory.teach("preference","new","value"))
	assert(not memory.teach("preference","format","bullets"))
	assert(not memory.forget(lesson_id))
	assert(memory.actor().lessons.size()==1 and memory.actor().lessons[0].value=="numbered")
	assert(FileAccess.get_file_as_string(memory.save_path)==memory_disk)
	var atomic=GenesisState.new();atomic.save_path="user://atomic-task.json"
	var queued=atomic.queue_task("Atomic draft","Source",0,"Template");assert(atomic.task_status(queued.id,"running"))
	atomic.save_enabled=false;assert(atomic.complete_task(queued.id,"Draft").is_empty())
	assert(atomic.data.documents.is_empty() and atomic.actor().energy==80)
	var atomic_reload=GenesisState.new();atomic_reload.save_path=atomic.save_path;atomic_reload.load_save()
	assert(atomic_reload.data.documents.is_empty() and atomic_reload.data.tasks[0].status=="failed" and atomic_reload.actor().energy==80)
	atomic.save_enabled=true
	var delivery=atomic.complete_task(queued.id,"Draft");assert(not delivery.is_empty())
	var repeated=atomic.complete_task(queued.id,"Different draft");assert(repeated.id==delivery.id)
	assert(atomic.data.documents.size()==1 and atomic.actor().energy==72 and atomic.data.stars==0)
	var no_save=GenesisState.new();no_save.save_enabled=false;assert(no_save.queue_task("No save","Notes",0,"Template").is_empty())
	var explorer=GenesisState.new();explorer.save_path="user://expedition-test.json"
	assert(not explorer.travel("archive") and explorer.data.exploration.zone=="workshop")
	explorer.data.garden=true;assert(explorer.travel("mosswood"));assert(explorer.discover())
	assert(explorer.discover() and explorer.data.exploration.discoveries.size()==1)
	var field_doc=explorer.deliver("Field report: Mosswood",explorer.field_notes("mosswood"),"Template",0)
	assert(not explorer.claim_expedition("fieldwork"));assert(explorer.approve(field_doc));assert(explorer.claim_expedition("fieldwork"))
	var balance=explorer.data.berries;assert(not explorer.claim_expedition("fieldwork") and explorer.data.berries==balance)
	assert(explorer.travel("workshop"));explorer.data.crew[0].approved=3;assert(explorer.travel("archive"));assert(explorer.discover());assert(explorer.claim_expedition("cartographer"))
	var old_profile=explorer.data.duplicate(true);old_profile.erase("exploration");assert(explorer.valid(old_profile));explorer.adopt(old_profile);assert(explorer.data.exploration.zone=="workshop")
	var bad_exploration=explorer.data.duplicate(true);bad_exploration.exploration.discoveries=["archive","archive"];assert(not explorer.valid(bad_exploration))
	bad_exploration=explorer.data.duplicate(true);bad_exploration.exploration.zone="../saves";assert(not explorer.valid(bad_exploration))
	explorer.data.garden=true;explorer.save_enabled=false;var before_travel=explorer.data.duplicate(true);assert(not explorer.travel("mosswood") and explorer.data==before_travel)
	explorer.data.exploration.zone="mosswood";assert(not explorer.discover() and explorer.data.exploration.discoveries.is_empty())
	if not preload("res://tests/save_safety_test.gd").new().run():quit(1);return
	print("GENESIS_STATE_TEST_OK: memory, approval, HTML escaping, saves, v2 migration, mission rewards, care, upgrades, levels")
	quit()
